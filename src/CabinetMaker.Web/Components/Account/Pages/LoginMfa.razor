@page "/login/mfa"
@layout AuthLayout

<PageTitle>Two-Factor Authentication</PageTitle>

<div class="card shadow-sm" style="width: 420px; max-width: 95vw;">
    <div class="card-body p-4">
        <h2 class="mb-2">Two-Factor Authentication</h2>
        <p class="text-muted mb-4">Enter the code from your authenticator app.</p>
        <StatusMessage Message="@message" />
        <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="login-mfa">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="RememberMe" value="@RememberMe" />
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.TwoFactorCode" id="twoFactorCode" class="form-control" autocomplete="off" placeholder="000000" />
                <label for="twoFactorCode">Authenticator Code</label>
                <ValidationMessage For="() => Input.TwoFactorCode" class="text-danger" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.RememberMachine" id="rememberMachine" class="form-check-input" />
                <label class="form-check-label" for="rememberMachine">Remember this device</label>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Verify</button>
        </EditForm>
        <p class="mt-3 text-center">
            <a href="login/recovery-code?ReturnUrl=@ReturnUrl">Use a recovery code</a>
        </p>
    </div>
</div>
