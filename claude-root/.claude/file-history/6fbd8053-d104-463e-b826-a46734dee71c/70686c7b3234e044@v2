services:
  web:
    image: ${REGISTRY_IMAGE:-cabinetmaker-web}:${IMAGE_TAG:-latest}
    ports:
      - "127.0.0.1:8080:8080"   # localhost only — register this port in your proxy console
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_URLS: http://+:8080
      DatabaseProvider: MySql
      ConnectionStrings__DefaultConnection: >-
        Server=db;Port=3306;Database=cabinetmaker;
        User=${DB_USER};Password=${DB_PASSWORD};
        AllowPublicKeyRetrieval=true;SslMode=None;
      Seed__AdminEmail: ${ADMIN_EMAIL}
      Seed__AdminPassword: ${ADMIN_PASSWORD}
    depends_on:
      db:
        condition: service_healthy
    restart: always

  db:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MYSQL_DATABASE: cabinetmaker
      MYSQL_USER: ${DB_USER}
      MYSQL_PASSWORD: ${DB_PASSWORD}
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test:
        - CMD
        - mysqladmin
        - ping
        - -h
        - localhost
        - -u
        - ${DB_USER}
        - --password=${DB_PASSWORD}
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    restart: always

volumes:
  mysql_data:
