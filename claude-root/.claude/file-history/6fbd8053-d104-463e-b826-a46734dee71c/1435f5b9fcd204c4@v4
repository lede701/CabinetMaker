using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace CabinetMaker.DAL.Extensions;

public static class DalServiceExtensions
{
    public static IServiceCollection AddDataLayer(this IServiceCollection services)
    {
        return DalServiceExtensions.AddDataLayer(services, new DalServiceConfiguration() { });
    }

    public static IServiceCollection AddDataLayer(this IServiceCollection services, Action<DalServiceConfiguration> configure)
    {
        var config = new DalServiceConfiguration();
        configure(config);
        return AddDataLayer(services, config);
    }

    public static IServiceCollection AddDataLayer(this IServiceCollection services, DalServiceConfiguration config)
    {
        services.AddSingleton(TimeProvider.System);
        services.AddCabinetMakerDatabase(config);
        return services;
    }
}
