using CabinetMaker.DAL.Context;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace CabinetMaker.DAL.Extensions;

public static class DatabaseProviderExtensions
{
    public static IServiceCollection AddCabinetMakerDatabase(
        this IServiceCollection services,
        IConfiguration configuration)
    {
        var provider = configuration["DatabaseProvider"] ?? "MySql";
        var connectionString = configuration.GetConnectionString("DefaultConnection")
            ?? throw new InvalidOperationException("Connection string 'DefaultConnection' is not configured.");

        services.AddDbContext<CmContext>(options =>
        {
            if (provider.Equals("MySql", StringComparison.OrdinalIgnoreCase))
                options.UseMySQL(connectionString);
            else if (provider.Equals("SqlServer", StringComparison.OrdinalIgnoreCase))
                options.UseSqlServer(connectionString);
            else
                throw new InvalidOperationException(
                    $"Unsupported database provider: '{provider}'. Valid values are 'MySql' or 'SqlServer'.");
        });

        return services;
    }
}
