@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3 text-muted small">@context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout" class="d-inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <MfaReminder @rendermode="InteractiveServer" />
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
