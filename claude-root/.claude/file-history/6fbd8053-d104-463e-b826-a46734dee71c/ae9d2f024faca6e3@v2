@page "/tools/measurement-converter"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Measurement Converter</PageTitle>

<h3 class="mb-4">Measurement Converter</h3>

<div class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">Value</label>
        <input type="number" class="form-control" value="@_fromValue"
               @oninput="OnValueInput" step="any" />
    </div>
    <div class="col-md-3">
        <label class="form-label">From</label>
        <select class="form-select" @bind="_fromUnitId" @bind:after="Recalculate">
            @foreach (var unit in _units)
            {
                <option value="@unit.UnitID">@unit.Name (@unit.Abbreviation)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="SwapUnits" title="Swap units">&#8644;</button>
    </div>
    <div class="col-md-3">
        <label class="form-label">To</label>
        <select class="form-select" @bind="_toUnitId" @bind:after="Recalculate">
            @foreach (var unit in _units)
            {
                <option value="@unit.UnitID">@unit.Name (@unit.Abbreviation)</option>
            }
        </select>
    </div>
</div>

<div class="card border-primary mb-4" style="max-width: 480px;">
    <div class="card-body">
        <p class="text-muted small mb-1">@_fromValue @_fromUnit?.Abbreviation =</p>
        <h2 class="mb-0">@FormatValue(_toValue, _toUnit) <span class="text-muted fs-5">@_toUnit?.Abbreviation</span></h2>
    </div>
</div>

<h5 class="mb-3">All Length Units</h5>
<table class="table table-sm table-bordered" style="max-width: 400px;">
    <thead class="table-light">
        <tr>
            <th>Unit</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in _units)
        {
            <tr class="@(unit.UnitID == _toUnitId ? "table-primary" : "")">
                <td>@unit.Name (@unit.Abbreviation)</td>
                <td>@AllUnitsValue(unit)</td>
            </tr>
        }
    </tbody>
</table>
