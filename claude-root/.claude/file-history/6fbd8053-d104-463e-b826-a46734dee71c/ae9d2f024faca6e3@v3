@page "/tools/measurement-converter"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Measurement Converter</PageTitle>

<h3 class="mb-4">Measurement Converter</h3>

<div class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">Value</label>
        <input type="number" class="form-control" value="@_fromValue"
               @oninput="OnValueInput" step="any" />
    </div>
    <div class="col-md-3">
        <label class="form-label">From</label>
        <select class="form-select" @bind="_fromUnitId" @bind:after="Recalculate">
            @foreach (var unit in _units)
            {
                <option value="@unit.UnitID">@unit.Name (@unit.Abbreviation)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="SwapUnits" title="Swap units">&#8644;</button>
    </div>
    <div class="col-md-3">
        <label class="form-label">To</label>
        <select class="form-select" @bind="_toUnitId" @bind:after="Recalculate">
            @foreach (var unit in _units)
            {
                <option value="@unit.UnitID">@unit.Name (@unit.Abbreviation)</option>
            }
        </select>
    </div>
</div>

@if (_toUnit?.IsSystemBase == true)
{
    <div class="mb-3 d-flex align-items-center gap-3">
        <label class="form-label mb-0 text-nowrap">Fraction precision:</label>
        <div class="d-flex gap-2">
            @foreach (var p in _precisionOptions)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="precision"
                           id="prec_@((int)p)" value="@((int)p)"
                           checked="@(_precision == p)"
                           @onchange="() => SetPrecision(p)" />
                    <label class="form-check-label" for="prec_@((int)p)">1/@((int)p)</label>
                </div>
            }
        </div>
    </div>
}

<div class="card border-primary mb-4" style="max-width: 480px;">
    <div class="card-body">
        <p class="text-muted small mb-1">@_fromValue @_fromUnit?.Abbreviation =</p>
        <h2 class="mb-0">
            @FormatDecimal(_toValue, _toUnit)
            <span class="text-muted fs-5">@_toUnit?.Abbreviation</span>
        </h2>
        @if (_toUnit?.IsSystemBase == true)
        {
            <p class="mb-0 mt-1 text-secondary">
                &#8776; <strong>@FractionHelper.ToFractionalInches(_toValue, _precision) in</strong>
                <span class="text-muted small ms-2">(nearest 1/@((int)_precision)")</span>
            </p>
        }
    </div>
</div>

<h5 class="mb-3">All Length Units</h5>
<table class="table table-sm table-bordered" style="max-width: 520px;">
    <thead class="table-light">
        <tr>
            <th>Unit</th>
            <th>Decimal</th>
            @if (_fromUnit is not null)
            {
                <th>Fraction</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in _units)
        {
            var val = AllUnitsValue(unit);
            <tr class="@(unit.UnitID == _toUnitId ? "table-primary" : "")">
                <td>@unit.Name (@unit.Abbreviation)</td>
                <td>@FormatDecimal(val, unit)</td>
                @if (_fromUnit is not null)
                {
                    <td>
                        @if (unit.IsSystemBase)
                        {
                            @FractionHelper.ToFractionalInches(val, _precision)
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
