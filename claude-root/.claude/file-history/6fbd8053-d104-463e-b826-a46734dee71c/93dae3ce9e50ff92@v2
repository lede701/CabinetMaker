using System.ComponentModel.DataAnnotations;
using Microsoft.EntityFrameworkCore;

namespace CabinetMaker.Domain.Entities;

public class JobEstimateLine : CmEntity, ITenantScoped
{
    [Key]
    public int JobEstimateLineId { get; set; }
    public Guid JobEstimateLineGuid { get; set; }
    public int TenantId { get; set; }
    public int JobEstimateId { get; set; }
    public int? PartId { get; set; }
    public int? TenantDiscountCodeId { get; set; }
    public int LineTypeId { get; set; }
    [MaxLength(500)]
    public string Description { get; set; } = string.Empty;
    [Precision(18, 4)]
    public decimal Quantity { get; set; }
    [Precision(18, 2)]
    public decimal UnitCost { get; set; }
    [Precision(18, 2)]
    public decimal TotalCost { get; set; }
    public int SortOrder { get; set; }
}
